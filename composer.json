{
	"name": "automattic/jetpack-comments",
	"description": "Replaces the default WordPress comment form.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-assets": "^5.0.17-alpha",
		"automattic/jetpack-image-cdn": "^0.8.4-alpha",
		"automattic/jetpack-connection": "^9.16.0-alpha",
		"automattic/jetpack-ip": "^0.7.1",
		"automattic/jetpack-status": "^7.1.1"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/phpunit-select-config": "^1.0.12"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"build-development": "pnpm run build",
		"build-production": "pnpm run build-production",
		"typecheck": "pnpm run typecheck",
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		],
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		],
		"test-php-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-trunk": "0.8.x-dev"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-comments/compare/v${old}...v${new}"
		},
		"mirror-repo": "Automattic/jetpack-comments",
		"textdomain": "jetpack-comments",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-comments.php"
		}
	}
}
